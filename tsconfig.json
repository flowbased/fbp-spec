{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.js",
    "lib/**/*.js",
    "schema/**/*.js",
    "scripts/**/*.js",
    "spec/**/*.js",
    "examples/**/*.js",
    "types.d.ts"
  ]
}
