{
  "name": "fbp-spec",
  "version": "0.8.0",
  "description": "Data-driven FBP component/graph testing tool",
  "keywords": [
    "fbp"
  ],
  "author": "Jon Nordby <jononor@gmail.com> (http://www.jonnor.com)",
  "repository": {
    "type": "git",
    "url": "http://github.com/flowbased/fbp-spec.git"
  },
  "bugs": "http://github.com/flowbased/fbp-spec/issues",
  "homepage": "http://flowbased.org",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./schema": "./schema/index.js",
    "./runner": "./lib/runner.js",
    "./testsuite": "./lib/testsuite.js",
    "./expectation": "./lib/expectation.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fbp-spec": "./bin/fbp-spec"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "lib",
    "schema",
    "index.js"
  ],
  "scripts": {
    "build": "node scripts/build-schemas.js",
    "lint": "npx @biomejs/biome check --use-editorconfig=true lib/ schema/ scripts/ spec/ examples/ index.js bin/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write lib/ schema/ scripts/ spec/ examples/ index.js bin/",
    "typecheck": "tsc",
    "test": "npm run lint && npm run typecheck && node --test \"spec/*.test.js\""
  },
  "dependencies": {
    "debug": "^4.4.3",
    "fbp": "^1.8.0",
    "fbp-client": "^0.4.3",
    "fbp-graph": "^0.7.0",
    "flowtrace": "^0.1.10",
    "js-yaml": "^5.4.3",
    "jsonpath": "^1.3.0",
    "tv4": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/debug": "^4.1.13",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/websocket": "^1.0.10",
    "typescript": "^7.0.2",
    "websocket": "^1.0.35"
  }
}
